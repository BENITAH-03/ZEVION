# ZEVION Backend Environment Variables
# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file to GitHub.

# Port the Express server listens on
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# PostgreSQL connection string
# Local example: postgresql://zevion:zevion_dev_password@localhost:5432/zevion_dev
# Render (production) gives you this connection string on the database page.
DATABASE_URL=postgresql://zevion:zevion_dev_password@localhost:5432/zevion_dev

# Set to "true" only if your PostgreSQL provider requires SSL (most cloud providers do,
# e.g. Render). Local PostgreSQL usually does not need this.
DATABASE_SSL=false

# Comma-separated list of allowed frontend origins for CORS.
# Local example: http://localhost:5173
# Production example: https://zevion.vercel.app
CORS_ORIGIN=http://localhost:5173

# Maximum number of contact form submissions allowed per IP address per time window
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
