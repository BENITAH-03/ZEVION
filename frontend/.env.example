# ZEVION Frontend Environment Variables
# Copy this file to ".env" for local development.

# Base URL of the backend REST API (must include the /api/v1 path).
# Local development:
VITE_API_URL=http://localhost:5000/api/v1

# Production example (replace with your deployed Render backend URL):
# VITE_API_URL=https://zevion-backend.onrender.com/api/v1
