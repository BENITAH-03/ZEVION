{
  "name": "zevion-backend",
  "version": "1.0.0",
  "description": "ZEVION backend API - Emergency Electric Mobility Support",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate:up": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.mjs up -m src/migrations",
    "migrate:down": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.mjs down -m src/migrations",
    "migrate:create": "node node_modules/node-pg-migrate/bin/node-pg-migrate.mjs create -m src/migrations",
    "seed": "node src/seeds/seed.js"
  },
  "keywords": [
    "zevion",
    "electric-mobility",
    "express",
    "postgresql"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
